{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atome",
  "version": "0.1.0",
  "identifier": "com.squirrel.desktop",
  "build": {
    "frontendDist": "../../atome/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "atome",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../atome/version.txt": "project/version.txt",
      "../../atome/src": "project/atome/src",
      "../../atome/security": "project/atome/security",
      "../../atome/engines": "project/atome/engines",
      "../../atome/documentations": "project/atome/documentations",
      "../../eVe": "project/eVe",
      "../../node_modules/rubberband-wasm/dist": "project/node_modules/rubberband-wasm/dist"
    }
  }
}
