#!/bin/sh
# PROVIDE: atome
# REQUIRE: LOGIN seatd atome_server
# KEYWORD: shutdown
. /etc/rc.subr
name="atome"
rcvar="atome_enable"
load_rc_config "$name"
: "${atome_enable:=NO}"
pidfile="/var/run/atome/ui.pid"
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -f -u atome /usr/local/libexec/aos/supervise.sh /usr/local/libexec/aos/start_atome.sh"
run_rc_command "$1"
