# Server-only setting for the public `food-facts` /ws/api frame (server/ws_open_food_facts.js).
# Open Food Facts requires an identifying User-Agent "AppName/Version (contact)"; without it the
# frame answers NOT_CONFIGURED. Product data licence: ODbL (credit Open Food Facts).
OPEN_FOOD_FACTS_USER_AGENT=atome.one/1.0 (https://atome.one)
