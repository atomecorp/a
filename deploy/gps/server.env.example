# Server-only endpoints; keep this file out of personal/provider credentials.
# Activate only after independent services and capacity are verified.
# Current production (public OSM services, light use under their usage policies):
# ATOME_GPS_VALHALLA_URL=https://valhalla1.openstreetmap.de
# ATOME_GPS_GEOCODER_URL=https://nominatim.openstreetmap.org
# ATOME_GPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Self-hosted stack:
ATOME_GPS_VALHALLA_URL=http://127.0.0.1:8002
ATOME_GPS_GEOCODER_URL=http://127.0.0.1:8003
ATOME_GPS_TILE_URL=http://127.0.0.1:8004/tiles/{z}/{x}/{y}.png
