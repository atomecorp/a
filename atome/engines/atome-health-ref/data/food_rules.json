 ],
 "rules": [
  {"id": "diabetes_t2_starches_al_dente", "condition": "diabetes_type_2", "kind": "preparation", "foods": ["starches"], "criteria": [], "text": "Cuire les féculents « al dente » : une surcuisson élève leur index glycémique.", "reason": "Une cuisson longue rend l'amidon plus vite digéré.", "source": "ffd_feculents"},
  {"id": "diabetes_t2_whole_grains", "condition": "diabetes_type_2", "kind": "prefer", "foods": ["whole_grains", "legumes"], "criteria": [], "text": "Privilégier les céréales complètes et les légumes secs.", "reason": "Leurs fibres et protéines végétales limitent la montée de la glycémie après le repas et prolongent la satiété.", "source": "ffd_feculents"},
  {"id": "diabetes_t2_starches_every_meal", "condition": "diabetes_type_2", "kind": "belief", "foods": ["starches"], "criteria": [], "text": "Ne pas se priver de féculents : ils se mangent à chaque repas (un quart à un tiers de l'assiette). Les appeler « sucres lents » est une erreur.", "reason": "S'en priver expose aux fringales et à l'hypoglycémie.", "source": "ffd_feculents"},
  {"id": "diabetes_t2_instant_starches", "condition": "diabetes_type_2", "kind": "limit", "foods": ["instant_starches"], "criteria": [], "text": "Limiter les féculents à cuisson rapide.", "reason": "Leur index glycémique est élevé, comme celui d'un féculent trop cuit.", "source": "ffd_feculents"},
  {"id": "diabetes_t2_honey_is_sugar", "condition": "diabetes_type_2", "kind": "belief", "foods": ["honey", "syrups"], "criteria": [], "text": "Le miel n'est pas un sucre « permis » : comme le sucre, c'est un sucre simple, qui compte parmi les produits sucrés.", "reason": "Le miel, les sirops et les jus de fruits apportent des sucres libres au même titre que le sucre ajouté.", "source": "ameli_diabete_alimentation"},
  {"id": "diabetes_t2_honey_free_sugar", "condition": "diabetes_type_2", "kind": "belief", "foods": ["honey", "syrups", "fruit_juice"], "criteria": [], "text": "Les sucres du miel, des sirops et des jus de fruits sont des sucres libres, à limiter comme le sucre ajouté.", "reason": "Définition des sucres libres de l'OMS.", "source": "who_sugars_2015"},
  {"id": "diabetes_t2_sweets_end_of_meal", "condition": "diabetes_type_2", "kind": "preparation", "foods": ["sugar"], "criteria": [], "text": "Un produit sucré se mange en dessert, à la fin d'un repas, jamais seul.", "reason": "Les protéines, fibres et graisses du repas limitent la montée de la glycémie.", "source": "ffd_produits_sucres"},
  {"id": "diabetes_t2_halve_recipe_sugar", "condition": "diabetes_type_2", "kind": "preparation", "foods": ["sugar"], "criteria": [], "text": "Dans un dessert, diviser au moins par deux le sucre de la recette.", "reason": "Le résultat reste réussi, seulement moins sucré.", "source": "ffd_produits_sucres"},
  {"id": "diabetes_t2_fruit_juice", "condition": "diabetes_type_2", "kind": "belief", "foods": ["fruit_juice"], "criteria": [], "text": "Un jus de fruits, même 100 % pur jus, n'équivaut pas à un fruit : il compte parmi les produits sucrés.", "reason": "Peu de fibres et des sucres liquides vite assimilés : la glycémie monte vite.", "source": "ffd_fruits_legumes"},
  {"id": "diabetes_t2_sugary_drinks", "condition": "diabetes_type_2", "kind": "avoid", "foods": ["sugary_drinks", "fruit_juice"], "criteria": [], "text": "Éviter les boissons sucrées, jus de fruits compris.", "reason": "Recommandation de la Fédération pour l'équilibre de la glycémie.", "source": "ffd_boissons"},
  {"id": "diabetes_t2_whole_fruit", "condition": "diabetes_type_2", "kind": "prefer", "foods": ["whole_fruit"], "criteria": [], "text": "Plutôt qu'un jus, un fruit entier : une orange compte parmi les fruits moyennement sucrés, une portion de 150 g.", "reason": "La Fédération déconseille les jus, même 100 % pur jus, et donne les fruits entiers en portions.", "source": "ffd_boissons"},
  {"id": "diabetes_t2_alcohol_with_food", "condition": "diabetes_type_2", "kind": "limit", "foods": ["alcohol"], "criteria": [], "text": "Limiter l'alcool, le réserver aux occasions et toujours l'accompagner d'une prise alimentaire.", "reason": "À jeun, l'alcool provoque des hypoglycémies importantes puis des hyperglycémies retardées.", "source": "ffd_boissons"},
  {"id": "diabetes_t2_dried_fruit", "condition": "diabetes_type_2", "kind": "limit", "foods": ["dried_fruit"], "criteria": [], "text": "Fruits secs : au petit-déjeuner ou en fin de repas, en petite quantité (3 abricots secs, 3 pruneaux, 1 figue sèche).", "reason": "Concentrés, ils apportent beaucoup de sucre et se mangent vite.", "source": "ffd_fruits_legumes"},
  {"id": "diabetes_t2_vegetable_oils", "condition": "diabetes_type_2", "kind": "prefer", "foods": ["vegetable_oils"], "criteria": [], "text": "Une cuillère à soupe d'huile végétale par repas (olive, colza, noix), en limitant beurre et crème. L'huile de colza ne se cuit pas.", "reason": "Plus d'oméga 3, moins d'acides gras saturés.", "source": "ffd_matieres_grasses"},
  {"id": "diabetes_t1_starches_al_dente", "condition": "diabetes_type_1", "kind": "preparation", "foods": ["starches"], "criteria": [], "text": "Cuire les féculents « al dente » : une surcuisson élève leur index glycémique.", "reason": "Une cuisson longue rend l'amidon plus vite digéré.", "source": "ffd_feculents"},
  {"id": "diabetes_t1_whole_grains", "condition": "diabetes_type_1", "kind": "prefer", "foods": ["whole_grains", "legumes"], "criteria": [], "text": "Privilégier les céréales complètes et les légumes secs.", "reason": "Leurs fibres limitent la montée de la glycémie après le repas.", "source": "ffd_feculents"},
  {"id": "diabetes_t1_honey_is_sugar", "condition": "diabetes_type_1", "kind": "belief", "foods": ["honey", "syrups"], "criteria": [], "text": "Le miel n'est pas un sucre « permis » : comme le sucre, c'est un sucre simple, qui compte parmi les produits sucrés.", "reason": "Le miel, les sirops et les jus de fruits apportent des sucres libres au même titre que le sucre ajouté.", "source": "ameli_diabete_alimentation"},
  {"id": "diabetes_t1_fruit_juice", "condition": "diabetes_type_1", "kind": "belief", "foods": ["fruit_juice"], "criteria": [], "text": "Un jus de fruits, même 100 % pur jus, n'équivaut pas à un fruit : il compte parmi les produits sucrés.", "reason": "Ses sucres liquides sont assimilés très vite.", "source": "ffd_fruits_legumes"},
  {"id": "diabetes_t1_alcohol_fasting", "condition": "diabetes_type_1", "kind": "limit", "foods": ["alcohol"], "criteria": [], "text": "Jamais d'alcool à jeun ; le limiter et l'accompagner d'une prise alimentaire.", "reason": "L'alcool à jeun provoque des hypoglycémies importantes puis des hyperglycémies retardées.", "source": "ffd_boissons"},
  {"id": "diabetes_t1_sweets_end_of_meal", "condition": "diabetes_type_1", "kind": "preparation", "foods": ["sugar"], "criteria": [], "text": "Un produit sucré se mange en dessert, à la fin d'un repas, plutôt que seul.", "reason": "Le repas limite la montée de la glycémie.", "source": "ffd_produits_sucres"},
  {"id": "hypertension_salt", "condition": "hypertension", "kind": "limit", "foods": ["salt", "salty_foods"], "criteria": [], "text": "Limiter le sel : 5 à 6 g par jour suffisent, soit environ une petite cuillère. Toute réduction est bénéfique.", "reason": "Le sel retient l'eau et élève la tension artérielle.", "source": "ameli_hta_alimentation"},
  {"id": "hypertension_hidden_salt", "condition": "hypertension", "kind": "limit", "foods": ["salty_foods"], "criteria": [], "text": "Modérer pain, fromages, charcuteries, poissons fumés, coquillages, plats préparés et biscuits apéritifs.", "reason": "Environ 80 % du sel consommé est déjà dans les aliments.", "source": "ameli_hta_alimentation"},
  {"id": "hypertension_labels", "condition": "hypertension", "kind": "preparation", "foods": ["salt"], "criteria": [], "text": "Lire l'étiquette : 1 g de sodium = 2,5 g de sel ; 0,3 g de sel ou moins pour 100 g est une teneur basse.", "reason": "Le sel figure aussi sous le nom de chlorure de sodium.", "source": "ameli_hta_alimentation"},
  {"id": "hypertension_seasoning", "condition": "hypertension", "kind": "preparation", "foods": ["salt"], "criteria": [], "text": "Relever les plats au jus de citron, aux épices et aux herbes aromatiques plutôt qu'au sel.", "reason": "Le goût est gardé avec moins de sel.", "source": "ameli_risque_cardiovasculaire"},
  {"id": "hypertension_liquorice", "condition": "hypertension", "kind": "limit", "foods": ["liquorice"], "criteria": [], "text": "Consommer la réglisse (aliment ou boisson) avec prudence et en quantité limitée.", "reason": "Conseil de l'Assurance Maladie aux personnes hypertendues.", "source": "ameli_hta_alimentation"},
  {"id": "hypertension_alcohol", "condition": "hypertension", "kind": "limit", "foods": ["alcohol"], "criteria": [], "text": "Modérer l'alcool : 10 verres standard par semaine au maximum, jamais plus de 2 par jour.", "reason": "Une consommation excessive élève la tension artérielle avec le temps.", "source": "ameli_hta_alimentation"},
  {"id": "hypertension_potassium_salt", "condition": "hypertension", "kind": "interaction", "foods": ["potassium_salt"], "criteria": [], "text": "Demander l'avis du médecin avant de remplacer le sel par un sel enrichi en potassium.", "reason": "Trop de potassium peut nuire en cas de maladie rénale ou de médicament qui élève le potassium.", "source": "ameli_hta_alimentation"},
  {"id": "cholesterol_saturated_fats", "condition": "hypercholesterolaemia", "kind": "limit", "foods": ["saturated_fats", "processed_meat", "red_meat"], "criteria": [], "text": "Limiter les graisses saturées : beurre, crème, fromages, charcuterie, viandes rouges, huiles de palme et de coco.", "reason": "Les acides gras saturés augmentent le LDL-cholestérol.", "source": "ameli_diabete_alimentation"},
  {"id": "cholesterol_unsaturated", "condition": "hypercholesterolaemia", "kind": "prefer", "foods": ["vegetable_oils", "oily_fish", "tree_nuts"], "criteria": [], "text": "Privilégier les huiles végétales, les fruits à coque et les poissons gras (saumon, maquereau, sardine).", "reason": "Les graisses insaturées, en particulier les oméga 3, aident à faire baisser le LDL-cholestérol.", "source": "ameli_diabete_alimentation"},
  {"id": "cholesterol_red_meat", "condition": "hypercholesterolaemia", "kind": "limit", "foods": ["red_meat", "processed_meat"], "criteria": [], "text": "Préférer la viande blanche, limiter la viande rouge à deux fois par semaine et les charcuteries.", "reason": "Conseil de prévention du risque cardiovasculaire.", "source": "ameli_risque_cardiovasculaire"},
  {"id": "cholesterol_whole_grains", "condition": "hypercholesterolaemia", "kind": "prefer", "foods": ["whole_grains"], "criteria": [], "text": "Choisir les féculents dans leur version complète.", "reason": "Les fibres protègent du risque cardiovasculaire.", "source": "ameli_risque_cardiovasculaire"},
  {"id": "cholesterol_sugary_drinks", "condition": "hypercholesterolaemia", "kind": "limit", "foods": ["sugary_drinks", "alcohol"], "criteria": [], "text": "Attention aux boissons sucrées ; l'alcool à 2 verres par jour et 10 par semaine au grand maximum.", "reason": "Graisses, sucres et alcool en excès élèvent le risque cardiovasculaire.", "source": "ameli_risque_cardiovasculaire"},
  {"id": "coeliac_gluten", "condition": "coeliac_disease", "kind": "avoid", "foods": ["gluten_cereals"], "criteria": [], "text": "Exclure le gluten : blé, seigle, orge, leurs hybrides et leurs dérivés.", "reason": "La maladie cœliaque est une maladie auto-immune déclenchée par le gluten de ces céréales.", "source": "afdiag_maladie_coeliaque"},
  {"id": "coeliac_label", "condition": "coeliac_disease", "kind": "prefer", "foods": ["gluten_cereals"], "criteria": [], "text": "Repérer le logo « épi barré », qui garantit l'absence de gluten.", "reason": "Bien distinguer les produits qui contiennent du gluten.", "source": "afdiag_regime_sans_gluten"},
  {"id": "coeliac_bulk", "condition": "coeliac_disease", "kind": "avoid", "foods": ["bulk_products"], "criteria": [], "text": "Éviter les produits en vrac.", "reason": "Ils présentent un risque de contamination croisée.", "source": "afdiag_regime_sans_gluten"},
  {"id": "coeliac_kitchen", "condition": "coeliac_disease", "kind": "preparation", "foods": ["gluten_cereals"], "criteria": [], "text": "Organiser la cuisine et nettoyer les surfaces avant de cuisiner sans gluten.", "reason": "Évite la contamination par le gluten.", "source": "afdiag_regime_sans_gluten"},
  {"id": "ckd_phosphate_additives", "condition": "chronic_kidney_disease", "kind": "avoid", "foods": ["phosphate_additives"], "criteria": [], "text": "Chasser les additifs phosphatés (E338 à E343, E450 à E452) : charcuteries, sauces allégées, boissons chocolatées, biscuits, plats déshydratés.", "reason": "Le phosphore des additifs est absorbé à 100 % et peut tripler l'apport.", "source": "france_rein_fiche_104"},
  {"id": "ckd_potassium_additives", "condition": "chronic_kidney_disease", "kind": "avoid", "foods": ["potassium_additives", "potassium_salt"], "criteria": [], "text": "Repérer les additifs potassiques (sorbate, nitrate, chlorure de potassium, E950…) et se méfier des produits « réduits en sel ».", "reason": "Ils remplacent souvent le sel par du potassium, absorbé en totalité.", "source": "france_rein_fiche_104"},
  {"id": "ckd_short_lists", "condition": "chronic_kidney_disease", "kind": "prefer", "foods": ["phosphate_additives", "potassium_additives", "salt"], "criteria": [], "text": "Préférer les listes d'ingrédients les plus courtes, faites d'ingrédients de cuisine.", "reason": "Les additifs de phosphore, de potassium et de sel y sont visibles.", "source": "france_rein_fiche_104"},
  {"id": "ckd_no_blind_restriction", "condition": "chronic_kidney_disease", "kind": "belief", "foods": ["phosphate_additives", "potassium_additives"], "criteria": [], "text": "Ne pas supprimer d'emblée bananes ou poissons gras : la chasse aux additifs passe avant toute restriction, à décider avec un diététicien spécialisé.", "reason": "Les restrictions fortes entraînent perte d'appétit et dénutrition.", "source": "france_rein_fiche_104"},
  {"id": "ckd_potassium_salt", "condition": "chronic_kidney_disease", "kind": "avoid", "foods": ["potassium_salt"], "criteria": [], "text": "Pas de sel enrichi en potassium sans avis médical.", "reason": "Un apport trop important de potassium peut être néfaste en cas de maladie rénale chronique.", "source": "ameli_hta_alimentation"},
  {"id": "gout_purines", "condition": "gout", "kind": "limit", "foods": ["offal", "red_meat", "processed_meat", "purine_fish"], "criteria": [], "text": "Limiter les aliments riches en purines : viande rouge, abats (ris de veau, cervelle, foie), charcuterie, anchois, hareng.", "reason": "Les purines se dégradent en acide urique et favorisent les crises.", "source": "ameli_goutte"},
  {"id": "gout_alcohol_beer", "condition": "gout", "kind": "limit", "foods": ["alcohol", "beer"], "criteria": [], "text": "Limiter l'alcool, la bière en particulier.", "reason": "Ils apportent des purines et élèvent l'acide urique.", "source": "ameli_goutte"},
  {"id": "gout_fructose", "condition": "gout", "kind": "limit", "foods": ["fructose_drinks"], "criteria": [], "text": "Limiter les boissons sucrées riches en fructose.", "reason": "Elles élèvent le taux d'acide urique.", "source": "ameli_goutte"},
  {"id": "pregnancy_listeria_cheese", "condition": "pregnancy", "kind": "avoid", "foods": ["raw_milk_cheese"], "criteria": [], "text": "Éviter les fromages au lait cru (surtout à pâte molle), la croûte des fromages et les fromages râpés vendus crus.", "reason": "Risque de listériose ; la bactérie ne change ni l'aspect, ni l'odeur, ni le goût.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_listeria_charcuterie", "condition": "pregnancy", "kind": "avoid", "foods": ["cooked_charcuterie"], "criteria": [], "text": "Éviter la charcuterie cuite (rillettes, pâtés, foie gras, produits en gelée) et les aliments servis à la coupe.", "reason": "Risque de listériose.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_raw_fish", "condition": "pregnancy", "kind": "avoid", "foods": ["raw_fish_seafood"], "criteria": [], "text": "Ne pas manger de poissons fumés ou crus, de coquillages crus, de surimi ni de tarama ; cuire le poisson à cœur.", "reason": "Risques de listériose et de parasites (Anisakis).", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_raw_meat", "condition": "pregnancy", "kind": "avoid", "foods": ["raw_meat"], "criteria": [], "text": "Éviter la viande crue ou peu cuite et la viande hachée peu cuite.", "reason": "Risques de toxoplasmose et de listériose.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_sprouts", "condition": "pregnancy", "kind": "avoid", "foods": ["raw_sprouts"], "criteria": [], "text": "Éviter les graines germées crues (soja…).", "reason": "Risque de listériose.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_predator_fish", "condition": "pregnancy", "kind": "avoid", "foods": ["large_predator_fish"], "criteria": [], "text": "Éviter espadon, marlin, siki, requin et lamproie.", "reason": "Ces grands prédateurs accumulent le méthylmercure.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_oily_fish", "condition": "pregnancy", "kind": "prefer", "foods": ["oily_fish"], "criteria": [], "text": "Manger du poisson deux fois par semaine, dont un poisson gras (sardine, maquereau, hareng, saumon hors saumon fumé), bien cuit.", "reason": "Les oméga 3 du poisson gras ; ne pas se priver de poisson.", "source": "ameli_grossesse_aliments"},
  {"id": "pregnancy_liquorice", "condition": "pregnancy", "kind": "avoid", "foods": ["liquorice"], "criteria": [], "text": "Pas de réglisse sous aucune forme (pastis sans alcool, sirops, confiseries, tisanes, compléments).", "reason": "Contre-indiquée pendant la grossesse et l'allaitement.", "source": "ameli_grossesse_aliments"},
  {"id": "breastfeeding_liquorice", "condition": "breastfeeding", "kind": "avoid", "foods": ["liquorice"], "criteria": [], "text": "Pas de réglisse sous aucune forme pendant l'allaitement.", "reason": "Contre-indiquée pendant la grossesse et l'allaitement.", "source": "ameli_grossesse_aliments"},
  {"id": "avk_vitamin_k_regular", "condition": "treatment_avk", "kind": "interaction", "foods": ["vitamin_k_foods"], "criteria": [], "text": "Garder une consommation régulière des aliments riches en vitamine K (choux, épinards, brocolis, certaines salades), sans changement brutal.", "reason": "Une modification soudaine des habitudes alimentaires déséquilibre l'INR.", "source": "ansm_thesaurus"},
  {"id": "avk_st_johns_wort", "condition": "treatment_avk", "kind": "avoid", "foods": ["st_johns_wort"], "criteria": [], "text": "Pas de millepertuis (contre-indication).", "reason": "Le millepertuis diminue l'effet de l'antivitamine K, avec un risque de thrombose.", "source": "ansm_thesaurus"},
  {"id": "statin_grapefruit", "condition": "treatment_statin", "kind": "interaction", "foods": ["grapefruit"], "criteria": [], "text": "Avec la simvastatine, pas de pamplemousse (jus et fruit) : association déconseillée. Avec l'atorvastatine, l'association est à prendre en compte.", "reason": "Le pamplemousse augmente la concentration de la statine, avec un risque d'effets musculaires.", "source": "ansm_thesaurus"},
  {"id": "allergy_gluten_cereals_avoid", "condition": "allergy_gluten_cereals", "kind": "avoid", "foods": ["gluten_cereals"], "criteria": [], "text": "Éviter les céréales contenant du gluten (blé, seigle, orge, avoine, épeautre, kamut) et leurs produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 1).", "source": "eu_1169_2011"},
  {"id": "allergy_crustaceans_avoid", "condition": "allergy_crustaceans", "kind": "avoid", "foods": ["crustaceans"], "criteria": [], "text": "Éviter les crustacés et leurs produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 2).", "source": "eu_1169_2011"},
  {"id": "allergy_eggs_avoid", "condition": "allergy_eggs", "kind": "avoid", "foods": ["eggs"], "criteria": [], "text": "Éviter les œufs et leurs produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 3).", "source": "eu_1169_2011"},
  {"id": "allergy_fish_avoid", "condition": "allergy_fish", "kind": "avoid", "foods": ["fish"], "criteria": [], "text": "Éviter les poissons et leurs produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 4).", "source": "eu_1169_2011"},
  {"id": "allergy_peanuts_avoid", "condition": "allergy_peanuts", "kind": "avoid", "foods": ["peanuts"], "criteria": [], "text": "Éviter les arachides et leurs produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 5).", "source": "eu_1169_2011"},
  {"id": "allergy_soy_avoid", "condition": "allergy_soy", "kind": "avoid", "foods": ["soy"], "criteria": [], "text": "Éviter le soja et ses produits.", "reason": "Allergène à déclaration obligatoire (annexe II, point 6).", "source": "eu_1169_2011"},
