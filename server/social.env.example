# Server-only developer configuration of the atome apps with the social networks.
# Keep real values in Private/social.env locally (chmod 600); production injects
# these variables through the existing service environment. Users never create
# developer apps: they only authorize atome on each network's official page.
#
# Public https origin of this server. Register these redirect URIs at each provider:
#   <SOCIAL_PUBLIC_BASE_URL>/api/social/oauth/callback/tiktok
#   <SOCIAL_PUBLIC_BASE_URL>/api/social/oauth/callback/instagram
#   <SOCIAL_PUBLIC_BASE_URL>/api/social/oauth/callback/facebook
SOCIAL_PUBLIC_BASE_URL=
# TikTok for Developers: Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 0 = do not request video.publish (Direct Post not approved): videos go to the TikTok inbox.
TIKTOK_DIRECT_POST=
# 1 only after TikTok's audit; before it every Direct Post is SELF_ONLY.
TIKTOK_AUDITED=0
# 1 only when SOCIAL_PUBLIC_BASE_URL's domain is verified for PULL_FROM_URL (photos).
TIKTOK_PULL_FROM_URL_VERIFIED=0
# Meta: Instagram API with Instagram Login (professional accounts).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta: Facebook Login for Pages (pages_show_list, pages_read_engagement, pages_manage_posts).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
