#!/usr/bin/env bash

# Build, archive, and distribute iOS through TestFlight (default) or private OTA.
# This script intentionally owns the release workflow only. auv3.sh remains the
# local-device AUv3 development launcher and is not a TestFlight release path.

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly IOS_DIRECTORY="$REPO_ROOT/platforms/ios/atome-auv3"
readonly CONFIGURATION="Release"
DISTRIBUTION_METHOD="app-store-connect"
CHANNEL="testflight"
PREPARE_ONLY=false
PUBLISH_REPORT=""
RELEASE_LOCK=""
readonly APP_STORE_CONNECT_DIRECTORY="$HOME/.appstoreconnect"
readonly APP_STORE_CONNECT_KEY_DIRECTORY="$APP_STORE_CONNECT_DIRECTORY/private_keys"
readonly APP_STORE_CONNECT_ISSUER_ID_FILE="$APP_STORE_CONNECT_DIRECTORY/issuer-id"
readonly ATOME_VERSION_FILE="$REPO_ROOT/atome/version.txt"
readonly EVE_VERSION_FILE="$REPO_ROOT/eVe/version.txt"
# Derived copy of the atome version, read by the GitHub auto-sync and by
# publish-to-github.sh; only its "version" key is rewritten.
readonly ATOME_VERSION_JSON_FILE="$REPO_ROOT/atome/src/version.json"
readonly EXPORT_COMPLIANCE_OPTION="2"
readonly EXPORT_COMPLIANCE_SELECTION="Standard encryption algorithms instead of, or in addition to, the encryption used in or accessed through Apple's operating system"

DRY_RUN=false
CURRENT_STEP="initialization"
CONTAINER_FLAG=""
CONTAINER_PATH=""
VERSION_LEDGER_PROJECT_FILE=""
APP_SCHEME=""
APP_TARGET=""
APP_BUNDLE_IDENTIFIER=""
MARKETING_VERSION=""
NEXT_MARKETING_VERSION=""
CURRENT_BUILD=""
NEXT_BUILD=""
TEAM_ID=""
SIGNING_STYLE=""
SIGNING_IDENTITY=""
API_KEY_ID=""
API_ISSUER_ID=""
API_PRIVATE_KEY_PATH=""
ATOME_VERSION=""
EVE_VERSION=""
PRODUCT_VERSION_BACKUPS=()
EXTENSION_TARGET_COUNT=0
EXTENSION_TARGETS=()

usage() {
    cat <<USAGE
Usage: ./scripts/$SCRIPT_NAME [--adhoc] [--dry-run | --prepare | --publish REPORT]

Ad Hoc: --prepare validates a signed IPA without publishing; --publish REPORT
revalidates and publishes it. --adhoc alone prepares and publishes.
Configure OTA_SSH_HOST and OTA_ORIGIN, or ~/.config/atome/ios-ota.json.
Remote Mac: node scripts/ios/remote.mjs --host SSH_ALIAS --repo ABSOLUTE_PATH --adhoc

Builds signed iOS releases. The default channel uploads to App Store Connect;
--adhoc publishes privately to the configured OTA server.

Options:
  --dry-run  Inspect the Xcode project and print the planned release settings.
             It does not change versions, archive, export, or upload.
  --export-compliance
             Print the recorded App Store Connect encryption declaration.
             It does not inspect, build, export, upload, or modify anything.
  -h, --help Show this help.

Live upload authentication:
  The Key ID is derived from the single AuthKey_*.p8 file below.
  Store the Issuer ID once in ~/.appstoreconnect/issuer-id.
  APP_STORE_CONNECT_ISSUER_ID remains supported for CI overrides.

Store the downloaded private key outside the repository at:
  ~/.appstoreconnect/private_keys/AuthKey_<your-key-id>.p8

The private key and Issuer ID are never copied, created, overwritten, or printed
by this script.
USAGE
}

print_export_compliance_guidance() {
    cat <<GUIDANCE

App Store Connect encryption declaration
  Select option $EXPORT_COMPLIANCE_OPTION: $EXPORT_COMPLIANCE_SELECTION.
  Reason: the iOS app uses standard CryptoKit primitives (SHA-1, SHA-256, and
  HMAC-SHA256), while its bundled web runtime verifies RSA-PSS/SHA-256
  signatures through WebCrypto. No proprietary, AES, libsodium, Olm, Megolm,
  or Matrix encryption implementation is present.
  This is an App Store Connect action and cannot be submitted by this local
  upload script. See platforms/ios/atome-auv3/README.md for the evidence and
  the remaining manual TestFlight steps.
GUIDANCE
}

fail() {
    printf '\nFAILED\nStep: %s\nReason: %s\n' "$CURRENT_STEP" "$1" >&2
    restore_product_version_files
    exit 1
}

# `set -E` lets this trap run inside the command substitutions the discovery
# helpers rely on. Reporting from there duplicated the banner and let the
# surrounding command hide the failure, so only the main shell reports.
on_error() {
    local exit_code=$?

    [ "$BASH_SUBSHELL" -eq 0 ] || exit "$exit_code"

    restore_product_version_files
    printf '\nFAILED\nStep: %s\nExit code: %s\n' "$CURRENT_STEP" "$exit_code" >&2
    exit "$exit_code"
}

trap on_error ERR

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "Required command is unavailable: $1"
}

source "$REPO_ROOT/scripts/ios/discovery.sh"

source "$REPO_ROOT/scripts/ios/versions.sh"

validate_environment() {
    CURRENT_STEP="environment validation"
    [ -d "$IOS_DIRECTORY" ] || fail "iOS project directory is missing: $IOS_DIRECTORY"
    require_command xcodebuild
    require_command xcrun
    require_command /usr/bin/ruby
    if [ "$CHANNEL" = testflight ]; then xcrun --find altool >/dev/null; fi
    require_command node
    xcodebuild -version >/dev/null
}

resolve_upload_credentials() {
    local private_key_path
    local private_key_count=0
    local private_key_name
    local derived_key_id
    local configured_issuer_id

    CURRENT_STEP="App Store Connect authentication"
    shopt -s nullglob
    for private_key_path in "$APP_STORE_CONNECT_KEY_DIRECTORY"/AuthKey_*.p8; do
        API_PRIVATE_KEY_PATH="$private_key_path"
        ((private_key_count += 1))
    done
    shopt -u nullglob

    [ "$private_key_count" -eq 1 ] || fail "Expected exactly one private key at $APP_STORE_CONNECT_KEY_DIRECTORY/AuthKey_*.p8."

    private_key_name="${API_PRIVATE_KEY_PATH##*/}"
    derived_key_id="${private_key_name#AuthKey_}"
    derived_key_id="${derived_key_id%.p8}"
    [[ "$derived_key_id" =~ ^[[:alnum:]]+$ ]] || fail "The private key file name must use the AuthKey_<key-id>.p8 format."

    if [ -n "${APP_STORE_CONNECT_KEY_ID:-}" ] && [ "$APP_STORE_CONNECT_KEY_ID" != "$derived_key_id" ]; then
        fail "APP_STORE_CONNECT_KEY_ID does not match the locally stored private key."
    fi
    API_KEY_ID="$derived_key_id"

    configured_issuer_id="${APP_STORE_CONNECT_ISSUER_ID:-}"
    if [ -z "$configured_issuer_id" ] && [ -r "$APP_STORE_CONNECT_ISSUER_ID_FILE" ]; then
        configured_issuer_id="$(tr -d '\r\n' < "$APP_STORE_CONNECT_ISSUER_ID_FILE")"
    fi

    [ -n "$configured_issuer_id" ] || fail "Store the App Store Connect Issuer ID in $APP_STORE_CONNECT_ISSUER_ID_FILE or set APP_STORE_CONNECT_ISSUER_ID."
    [[ "$configured_issuer_id" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] || fail "The App Store Connect Issuer ID must be a UUID."
    [ -r "$API_PRIVATE_KEY_PATH" ] || fail "App Store Connect private key is unreadable: $API_PRIVATE_KEY_PATH"

    API_ISSUER_ID="$configured_issuer_id"
}

write_export_options() {
    local export_options_path="$1"

    cat > "$export_options_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>destination</key>
    <string>export</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>method</key>
    <string>$DISTRIBUTION_METHOD</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>teamID</key>
    <string>$TEAM_ID</string>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
PLIST
}

print_release_summary() {
    printf '%s\n' "Project: $CONTAINER_PATH"
    printf '%s\n' "Scheme: $APP_SCHEME"
    printf '%s\n' "Application target: $APP_TARGET ($APP_BUNDLE_IDENTIFIER)"
    printf '%s\n' "Embedded extension targets: ${EXTENSION_TARGETS[*]:-none}"
    printf '%s\n' "Signing: $SIGNING_STYLE (${SIGNING_IDENTITY:-unspecified}), team $TEAM_ID"
    printf '%s\n' "Current version: $MARKETING_VERSION"
    printf '%s\n' "atome version: $ATOME_VERSION ($ATOME_VERSION_FILE)"
    printf '%s\n' "eVe version: $EVE_VERSION ($EVE_VERSION_FILE)"
    printf '%s\n' "New version (iOS, atome, eVe): $NEXT_MARKETING_VERSION"
    printf '%s\n' "Current build: $CURRENT_BUILD"
    printf '%s\n' "New build: $NEXT_BUILD"
}

parse_arguments() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --adhoc) CHANNEL="adhoc"; DISTRIBUTION_METHOD="release-testing" ;;
            --prepare) PREPARE_ONLY=true ;;
            --publish) shift; [ "$#" -gt 0 ] || fail "--publish requires a report"; PUBLISH_REPORT="$1" ;;
            --dry-run) DRY_RUN=true ;;
            --export-compliance) print_export_compliance_guidance; exit 0 ;;
            -h|--help) usage; exit 0 ;;
            *) fail "Unknown option: $1" ;;
        esac
        shift
    done
}

main() {
    parse_arguments "$@"
    if [ "$DRY_RUN" = true ] && { [ "$PREPARE_ONLY" = true ] || [ -n "$PUBLISH_REPORT" ]; }; then
        fail "--dry-run cannot be combined with --prepare or --publish"
    fi
    if [ "$PREPARE_ONLY" = true ] && [ -n "$PUBLISH_REPORT" ]; then fail "Choose --prepare or --publish"; fi
    if [ "$CHANNEL" = testflight ] && { [ "$PREPARE_ONLY" = true ] || [ -n "$PUBLISH_REPORT" ]; }; then
        fail "--prepare and --publish require --adhoc"
    fi
    if [ "$DRY_RUN" = false ]; then acquire_release_lock; fi
    if [ -n "$PUBLISH_REPORT" ]; then publish_prepared_release "$PUBLISH_REPORT"; return; fi
    validate_environment

    CURRENT_STEP="Xcode project discovery"
    resolve_xcode_container
    resolve_version_ledger
    discover_application_scheme

    local app_settings
    app_settings="$(release_settings_for_scheme "$APP_SCHEME")"
    APP_BUNDLE_IDENTIFIER="$(extract_setting "$app_settings" "PRODUCT_BUNDLE_IDENTIFIER")"
    [ -n "$APP_BUNDLE_IDENTIFIER" ] || fail "PRODUCT_BUNDLE_IDENTIFIER is not configured for scheme $APP_SCHEME."
    discover_release_targets
    print_release_summary

    if [ "$DRY_RUN" = true ]; then
        printf '\nDRY RUN SUCCESS\n'
        printf '%s\n' "No version was changed. No archive, export, or upload was started."
        printf '%s\n' "Planned version files: atome/version.txt, eVe/version.txt, atome/src/version.json -> $NEXT_MARKETING_VERSION"
        printf '%s\n' "Planned archive: xcodebuild archive ... CURRENT_PROJECT_VERSION=$NEXT_BUILD"
        printf '%s\n' "Planned export method: $DISTRIBUTION_METHOD"
        if [ "$CHANNEL" = testflight ]; then
            printf '%s\n' "Planned uploader: xcrun altool with App Store Connect API-key authentication"
            printf '%s\n' "A live upload additionally requires one AuthKey_*.p8 private key and the Issuer ID documented by --help."
        else printf '%s\n' "Planned publication: verified SSH transfer and atomic OTA publication, no App Store Connect upload"; fi
        if [ "$CHANNEL" = adhoc ]; then
            node "$REPO_ROOT/scripts/ios/signing.mjs" inspect "$TEAM_ID"
        else print_export_compliance_guidance; fi
        return
    fi

    if [ "$CHANNEL" = testflight ]; then resolve_upload_credentials; fi

    local run_directory
    local archive_path
    local export_path
    local export_options_path
    local ipa_path

    if [ "$CHANNEL" = adhoc ]; then
        run_directory="$(mktemp -d "$REPO_ROOT/temp/ios-adhoc.XXXXXX")"
    else run_directory="$(mktemp -d "$REPO_ROOT/temp/testflight.XXXXXX")"; fi
    archive_path="$run_directory/Atome-$NEXT_MARKETING_VERSION-$NEXT_BUILD.xcarchive"
    export_path="$run_directory/export"
    export_options_path="$run_directory/ExportOptions.plist"
    write_export_options "$export_options_path"

    CURRENT_STEP="Writing product versions"
    write_product_version_files

    CURRENT_STEP="Release archive"
    xcodebuild_for_container \
        -allowProvisioningUpdates \
        -scheme "$APP_SCHEME" \
        -configuration "$CONFIGURATION" \
        -destination "generic/platform=iOS" \
        -archivePath "$archive_path" \
        "MARKETING_VERSION=$NEXT_MARKETING_VERSION" \
        "CURRENT_PROJECT_VERSION=$NEXT_BUILD" \
        archive

    CURRENT_STEP="iOS $CHANNEL export"
    xcodebuild -exportArchive \
        -allowProvisioningUpdates \
        -archivePath "$archive_path" \
        -exportPath "$export_path" \
        -exportOptionsPlist "$export_options_path"

    ipa_path="$(find "$export_path" -maxdepth 1 -type f -name '*.ipa' -print -quit)"
    [ -n "$ipa_path" ] || fail "The export completed without producing an IPA."

    if [ "$CHANNEL" = adhoc ]; then
        finish_adhoc_release "$run_directory" "$ipa_path"
        return
    fi

    CURRENT_STEP="App Store Connect upload"
    xcrun altool --upload-app \
        --type ios \
        --file "$ipa_path" \
        --apiKey "$API_KEY_ID" \
        --apiIssuer "$API_ISSUER_ID"

    CURRENT_STEP="Persisting published version"
    persist_version_ledger
    # Published: the written product versions are now the truth.
    PRODUCT_VERSION_BACKUPS=()

    printf '\nSUCCESS\n\n'
    printf '%s\n' "Version: $NEXT_MARKETING_VERSION"
    printf '%s\n' "Build: $NEXT_BUILD"
    printf '%s\n' "Archive: OK ($archive_path)"
    printf '%s\n' "Export: OK ($ipa_path)"
    printf '%s\n' "Upload App Store Connect: OK"
    printf '\n%s\n' "Build $NEXT_BUILD was sent to App Store Connect. It should appear in TestFlight after Apple processing."
    print_export_compliance_guidance
}

source "$REPO_ROOT/scripts/ios/adhoc.sh"

main "$@"
