new file mode 100644
index 0000000..4562efc
--- /dev/null
+++ b/domains/dashboard/dashboard_ongoing_tool.js
@@ -0,0 +1,101 @@
+/**
+ * The « en cours » tool (AGENTS.md rule 13; L3 validated 2026-10-28; user request of 2 Nov. 2026): while an activity is
+ * under way (#programs/activity_ongoing.js, the one source of truth), a tool-sized orange disc — the activity's own disc
+ * (#dashboard_training_disc.js), its ring the step under way — lies right above the assistant, on every view where she
+ * stays: the home, a rubric (its grid keeps that cell free), a panel on the stage, a project (the ribbon's Atome handle;
+ * the contextual rail rises by one tool). Its own tree on the main menu's layer, over every panel: never covered, never
+ * dropped by a state of the band. A touch goes straight back to the activity, the same session (its card); several
+ * under way, « En direct » lists them (#dashboard_ongoing_scene.js), whose foot then carries the toggle (the tool leaves).
+ * It goes when the activity really ends; leaving its screen ends nothing.
+ *
+ * Anchors (`anchorOngoingTool({ box, visible, openAll, reach? })`): the views that lay an assistant. `box()`: the tool's place
+ * (surface px) or null; `visible()`: that view is the one shown; `openAll()`: « En direct »; `reach()`: the Dashboard, from a
+ * view that is not it (a project). The first visible wins.
+ */
+import { eveT } from '../../i18n/i18n.js';
+import { installEveBevyUiRuntime } from '../rendering/bevy_ui_runtime.js';
+import { decorateWorkspaceBevyUiTree } from '../rendering/workspace_scene_layers.js';
+import { reportRuntimeError } from '#squirrel/runtime_errors.js';
+import { observeOngoingActivities, ongoingActivities } from '../programs/activity_ongoing.js';
+import { observeOngoingScene, ongoingSceneShown } from './dashboard_ongoing_scene.js';
+import { trainingActionDisc } from './dashboard_training_disc.js';
+import { panelBodyLayer } from '../../intuition/runtime/bevy_panel/bevy_panel_tree.js';
+
+export const ONGOING_TOOL_TREE_ID = 'eve_dashboard_ongoing_tool';
+// Painted above every panel (stacked from 1250) and the stage's band (3000): what is touched there is what is drawn.
+const ONGOING_TOOL_DEPTH = 3001;
+const anchors = new Set(), listeners = new Set();
+let laid = null, laying = '', painting = null, again = false, started = false;
+const ui = () => installEveBevyUiRuntime();
+const anchor = () => [...anchors].find(entry => entry.visible()) || null;
+
+// Where the tool lies now (surface px), null while it is not shown: a rubric's grid keeps it free, the rail rises over it,
+// a touch under an open rubric reaches it (#dashboard_footer_navigation.js#touchAt).
+export const ongoingToolRect = () => laid;
+export const ongoingToolAt = (x, y) => !!laid && x >= laid.x && x <= laid.x + laid.width && y >= laid.y && y <= laid.y + laid.height;
+// Told whenever the tool comes, goes or moves.
+export const observeOngoingTool = listener => { listeners.add(listener); return () => listeners.delete(listener); };
+
+// Straight back to the activity (its card, the same session); several, « En direct » where the tool lies.
+export const openOngoingTool = async () => {
+    const shown = anchor(), list = ongoingActivities();
+    if (!shown) return { ok: false, error: 'dashboard_ongoing_view_missing' };
+    if (list.length !== 1) return shown.openAll();
+    // An activity's card lies on the Dashboard: a view elsewhere (a project) goes there first (`reach()`).
+    await shown.reach?.();
+    return list[0].open();
+};
+
+// A panel's slab or its tools band lying on the tool's place (a phone's panel spans the width at the foot, its band's last tool
+// right above the assistant): the tool steps aside meanwhile, never over the panel's own tools (whether that place should be kept
+// free in a panel is the user's open decision, BUG-006 cause 2, R-107). Read from the panel trees on screen (their root, or
+// their first nodes: the slab).
+const meets = (a, b) => a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
+const boxOf = style => (Array.isArray(style?.position) && Array.isArray(style?.size)
+    ? { x: Number(style.position[0]), y: Number(style.position[1]), width: Number(style.size[0]), height: Number(style.size[1]) } : null);
+const covered = (box) => [...ui().state.trees.entries()].some(([id, entry]) => id !== ONGOING_TOOL_TREE_ID && entry.tree?.root?.layer === 'panel'
+    && !ui().state.suspendedTrees?.has?.(id)
+    && (boxOf(entry.tree.root.style) ? [boxOf(entry.tree.root.style)] : (entry.tree.root.children || []).map(child => boxOf(child.style)).filter(Boolean))
+        .some(other => meets(other, box)));
+
+const build = (box, entry) => {
+    const disc = trainingActionDisc({ id: `${ONGOING_TOOL_TREE_ID}_disc`, x: 0, y: 0, width: box.width, size: box.width * 5 / 6,
+        ringBand: box.width / 12, screen: true, content: null, ring: entry.ring?.() ?? null, label: eveT('eve.dashboard.mystic.ongoing'),
+        onActivate: () => { void Promise.resolve(openOngoingTool()).catch(error => reportRuntimeError(error, 'dashboard:ongoing_tool')); } });
+    const tree = decorateWorkspaceBevyUiTree({ layer: 'mainMenu', tree: { id: ONGOING_TOOL_TREE_ID, root: {
+        id: `${ONGOING_TOOL_TREE_ID}_root`, kind: 'root', style: { position: [box.x, box.y], size: [box.width, box.height] }, children: [disc] } } });
+    return { ...tree, root: panelBodyLayer(tree.root, ONGOING_TOOL_DEPTH, true) };
+};
+
+const paintOnce = async () => {
+    const list = ongoingActivities(), shown = anchor();
+    const place = list.length && shown && !ongoingSceneShown() ? shown.box() : null;
+    const box = place && !covered(place) ? place : null;
+    const ring = box ? JSON.stringify(list[0].ring?.() ?? null) : '';
